[Unit]
Description=Export the shape of Caddy's routes for helmsman-security
After=caddy.service

[Service]
Type=oneshot
User=hs-caddy
Group=hs-caddy
ExecStart=/usr/local/share/hs-caddy/export-shape.sh
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/hs-caddy
